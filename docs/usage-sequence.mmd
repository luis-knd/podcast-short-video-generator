---
title: Sequence Flow for Alignment-Aware Short Generation with B-roll
config:
  theme: base
  look: classic
  themeVariables:
    background: "#fffdf8"
    actorBkg: "#fff6de"
    actorBorder: "#a77705"
    actorTextColor: "#2d2000"
    signalColor: "#2f62c9"
    signalTextColor: "#20324f"
    labelBoxBkgColor: "#e7f0ff"
    labelBoxBorderColor: "#3963a3"
    loopTextColor: "#284b8f"
    noteBkgColor: "#fff7e8"
    noteBorderColor: "#b15b2f"
    activationBkgColor: "#dff5ea"
    activationBorderColor: "#2f7b5f"
  themeCSS: |
    .actor {
      animation: pulse-actor 2.2s infinite alternate !important;
      stroke-width: 2px !important;
    }
    .messageLine0, .messageLine1 {
      stroke-dasharray: 8 !important;
      animation: line-flow 1.2s linear infinite !important;
      stroke-width: 2.2px !important;
    }
    .noteText, .loopText {
      font-weight: 700 !important;
    }
    @keyframes pulse-actor {
      from { fill: #fffdf8; stroke: #a77705; }
      to { fill: #ffe8b3; stroke: #b15b2f; }
    }
    @keyframes line-flow {
      from { stroke-dashoffset: 18; }
      to { stroke-dashoffset: 0; }
    }
---
sequenceDiagram
    autonumber
    actor U as User
    participant CLI as main.py CLI
    participant RI as ResolveIntervalsUseCase
    participant VIG as ViralSubtitleIntervalGenerator
    participant CG as IntervalCandidateGenerator
    participant VS as IntervalViralityScorer
    participant SEL as DiversityAwareIntervalSelector
    participant UC as GenerateShortUseCase
    participant VP as FFmpegVideoProcessor
    participant SP as SubtitleProcessor
    participant C as AlignmentCache
    participant FW as FasterWhisperWordAligner
    participant R as TranscriptReconciler
    participant AW as ApproximateWordAligner
    participant BP as BuildShortEditingPlanUseCase
    participant ID as ImpactBeatDetector
    participant OR as ManualBrollOverrideResolver
    participant QG as BrollQueryGenerator
    participant PR as Stock/Local Providers
    participant OL as ManualBrollOverrideLoader
    participant BW as BrollPlanJsonWriter
    participant ASS as AssWriter
    participant FF as ffmpeg

    U->>+CLI: Run generator with video, subtitles and intervals
    alt manual intervals exist and --auto-intervals is false
        CLI->>CLI: reuse existing recortes.json
    else missing intervals or forced auto regeneration
        CLI->>+RI: execute(subs, manual_intervals, force_auto_generation)
        RI->>+VIG: generate(subtitles_filepath)
        VIG->>+CG: build candidates from SubtitleCue
        CG-->>-VIG: interval candidates
        VIG->>+VS: score candidates for virality
        VS-->>-VIG: scored candidates
        VIG->>+SEL: select diverse top intervals
        SEL-->>-VIG: selected intervals
        VIG-->>-RI: JSON-compatible intervals
        RI-->>-CLI: resolved intervals + warnings
        alt auto generation succeeded
            CLI->>CLI: overwrite --intervals path atomically
        else fallback to valid manual file
            CLI->>CLI: preserve manual recortes.json
        end
    end
    CLI->>+UC: execute(video, subs, intervals, output)
    loop for each interval
        UC->>+VP: generate_short(video, interval, format, output)
        VP->>+SP: build_timeline(srt, interval, ass, media)
        Note over SP: Parse cues and decide alignment mode
        alt alignment enabled and media path available
            SP->>C: load_raw(raw_key)
            alt raw_asr cache hit
                C-->>SP: raw ASR words
            else raw_asr cache miss
                C-->>SP: cache miss
                SP->>FW: align(full source media)
                FW-->>SP: raw ASR words + metadata
                SP->>C: save_raw(raw_key, payload)
                C-->>SP: persisted
            end
            SP->>C: load_reconciled(reconciled_key)
            alt reconciled cache hit
                C-->>SP: reconciled cues
            else reconciled cache miss
                C-->>SP: cache miss
                SP->>R: reconcile(cues, aligned_words)
                alt reconciliation quality is acceptable
                    R-->>SP: reconciled cues + quality
                    SP->>C: save_reconciled(key, payload)
                    C-->>SP: persisted
                else quality too low or matching fails
                    R-->>SP: low-confidence result
                    SP->>AW: build approximate cues
                    AW-->>SP: approximate cues
                end
            end
        else alignment disabled or unavailable
            SP->>AW: build approximate cues
            AW-->>SP: approximate cues
        end
        SP-->>VP: subtitle timeline
        VP->>ASS: write(segments, short_N.ass)
        ASS-->>VP: .ass written
        opt broll.enabled
            VP->>+BP: build(short_id, timeline, output_dir, target_size)
            BP->>+ID: detect(timeline)
            ID-->>-BP: impact beats
            BP->>OL: load()
            OL-->>BP: manual overrides
            BP->>OR: resolve(short_id, timeline, beats, overrides)
            OR-->>BP: manual selections
            loop for each beat
                alt manual override matched
                    BP-->>BP: skip provider search for that beat
                else automatic fallback
                    BP->>QG: generate(beat)
                    QG-->>BP: queries
                    BP->>PR: search(beat, queries)
                    PR-->>BP: candidates
                end
            end
            BP->>BW: write impact/candidates/plan JSON
            BW-->>BP: artifacts persisted
            BP-->>-VP: ShortEditingPlan
        end
        VP->>+FF: render split-screen
        opt plan has insertions
            FF-->>FF: compose overlay/cutaway/full_frame_cutaway
        end
        FF-->>FF: burn ASS over composited video
        alt outro enabled
            FF-->>FF: append outro with fades
        end
        FF-->>-VP: short_N.mp4
        VP-->>-UC: ShortVideo
    end
    UC-->>-CLI: generated shorts list
    CLI-->>-U: print output paths
